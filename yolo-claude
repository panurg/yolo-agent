#!/usr/bin/env sh

mkdir -p "$HOME/.yolo-agent-home"

exec docker run -it --rm \
  --name yolo-agent \
  --hostname yolo-agent \
  --user "$(id -u):$(id -g)" \
  --cap-drop=ALL \
  --security-opt=no-new-privileges \
  --read-only \
  --tmpfs /tmp \
  -v "$HOME/.yolo-agent-home:/home/ubuntu:rw" \
  -v "$(pwd):/work:rw" \
  ghcr.io/panurg/yolo-agent:release \
  claude --dangerously-skip-permissions
